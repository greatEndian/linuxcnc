					}
					
					if(hommingAccelSI != 0.0)
					{
						alim = hommingAccelSI;
					}
					else
					{
						hommingError = home_state + 1001;
						home_state = homing_initHomingSwitch;
						return;
					}
					
					// Store original signs
					double original_vlim_sign = (vlim >= 0.0) ? 1.0 : -1.0;
					
					// Use absolute values for calculations
					vlim_abs = fabs(vlim);
					alim_abs = fabs(alim);
					
					// actual position point setup
					x0 = pos_fb_from_incremental;
					
					// target position calculation - consider direction
					if(original_vlim_sign > 0.0)
					{
						// Moving in positive direction
						xf = probedEdge - fabs(reverseDistanceLocal);
					}
					else
					{
						// Moving in negative direction
						xf = probedEdge + fabs(reverseDistanceLocal);
					}
					
					// trajectory calculation
					double posDif0 = xf - x0;
					
					// Calculate direction based on actual needed movement
					if(fabs(posDif0) < pos_eps)
					{
						// Already at target
						dir = 0.0;
					}
					else
					{
						dir = (posDif0 >= 0.0) ? 1.0 : -1.0;
					}
					
					// trajectory absolute calculation
					double posDif0Abs = fabs(posDif0);
					
					// time of accell/deccell
					double Ta_cand0 = vlim_abs / alim_abs;
					
					// trajectory of accell/deccell
					double Da_acc0  = 0.5 * alim_abs * Ta_cand0 * Ta_cand0;
					
					// non constant speed movement trajectory calculation
					double Dmin0    = 2.0 * Da_acc0;
					
					// type of movement calculation metric or trapezoidal profile
					if (posDif0Abs <= Dmin0 + pos_eps)
					{// metric (triangular profile)
						Ta = sqrt(posDif0Abs / alim_abs);
						Td = Ta;
						Tc = 0.0;
						// Recalculate vlim based on triangular profile
						vlim_abs = alim_abs * Ta;
					}
					else 
					{// trapezoidal
						Ta = Ta_cand0;
						Td = Ta_cand0;
						double Dcruise = posDif0Abs - 2.0 * Da_acc0;
						Tc = Dcruise / vlim_abs;
					}
					
					// Reset movement state
					t_acc_elapsed = 0.0;
					t_cruise_elapsed = 0.0;
					t_dec_elapsed = 0.0;
					v = 0.0;  // Reset velocity
					
					stepper = true;
					if(stepper)
					{
						stepper = false;
						phase = ptpMov_accellMovement;
						home_state = homing_searching_zeroPointPtpMovementEdgeFind;
					}
					
					if (fabs(posDif0) < pos_eps)
					{// check if movement is less than resolution
						if(homingMethod >= 0)
						{
							home_state = homing_zeroPointOffsetSetup;
							phase = ptpMov_finalDelay;
						}
					}
					
					// write position command
					positionOutput = positionMemory;
				}
				break;

				case homing_searching_zeroPointPtpMovementEdgeFind:
				{
					positionOutput = positionMemory;
					switch(phase)
					{
						case ptpMov_accellMovement:
						{
							// Acceleration phase
							a = alim_abs * dir;
							v += a * periodTime;
							
							positionOutput = positionMemory + v * periodTime - 0.5 * a * periodTime * periodTime;
							
							t_acc_elapsed += periodTime;
							if (t_acc_elapsed >= Ta)
							{
