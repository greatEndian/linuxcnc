					}
					else
					{
						xf = probedEdgeNeg;
					}
					
					// trajectory calculation
					double posDif1 = xf - x0;
					
					// trajectory sign calculation
					dir = (fabs(posDif1) < pos_eps) ? 0.0 : ((posDif1 >= 0.0) ? 1.0 : -1.0);
					
					// trajectory absolute calculation
					double posDif1Abs = fabs(posDif1);
					
					// time of accell/deccell
					double Ta_cand1 = vlim / alim;
					
					// trajectory of accell/deccell
					double Da_acc1  = 0.5 * alim * Ta_cand1 * Ta_cand1;
					
					// non constant speed movement trajectory calculation
					double Dmin1    = 2.0 * Da_acc1;
					
					// type of movement calculation metric or trapezoidal profile
					if (posDif1Abs <= Dmin1 + pos_eps)
					{// metric 
						Ta = sqrt(posDif1Abs / alim);
						Td = Ta;
						Tc = 0.0;
					}
					else 
