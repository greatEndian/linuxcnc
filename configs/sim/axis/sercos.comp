	#define		homing_deccellAfterMovingFromHomingSwitch				30

	#define		homing_searching_ForProbeWithAccell						100
	#define		homing_searching_ForProbeConstSpeed						110
	#define		homing_searching_deccellerationAfterProbeHit			120
	#define		homing_searching_zeroPointPtpMovementCalculusEdgeFind	130
	#define		homing_searching_zeroPointPtpMovementEdgeFind			140
	#define		homing_searching_zeroPointPtpMovementCalculus			150
	#define		homing_searching_zeroPointPtpMovement					160
	#define		homing_offsetting_zeroPointPtpMovementCalculus			170
