							}
						}
					}
				}
				break;

				case homing_searching_zeroPointPtpMovementCalculusEdgeFind:
				{
					if(homingSpeedSI != 0.0)
					{
						vlim = homingSpeedSI;
					}
					else
					{
						hommingError = home_state + 1000;
						home_state = homing_initHomingSwitch;
