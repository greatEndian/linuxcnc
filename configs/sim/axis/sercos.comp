							a = 0.0;
							v = vlim_abs * dir;
							positionOutput = positionMemory + v * periodTime;
							
							t_cruise_elapsed += periodTime;
							if (t_cruise_elapsed >= Tc)
							{
								phase = ptpMov_deccellMovement;
							}
						}
						break;
							
						case ptpMov_deccellMovement:
