EXTRA_SETUP ()
{// initialize variables
	  pos_scale = 1.0;
	  pos_scale_old = pos_scale + 1.0;
	  pos_scale_rcpt = 1.0;
	  velo_scale = 1.0;
	  velo_scale_old = velo_scale + 1.0;
	  velo_scale_rcpt = 1.0;
	  auto_fault_reset = 1;
	  return 0;
}

void check_scales(hal_float_t *scale,float *scale_old, double *scale_rcpt) {
  // check for change in scale value
  if (*scale != *scale_old) {
    // scale value has changed, test and update it
    if ((*scale < 1e-20) && (*scale > -1e-20)) {
      // value too small, divide by zero is a bad thing
      *scale = 1.0;
    }
    // save new scale to detect future changes
    *scale_old = *scale;
    // we actually want the reciprocal
    *scale_rcpt = 1.0 / *scale;
  }
}

void getOperationBits3(uint32_t inputWord, uint32_t bitShiftRight, uint32_t numberOfRestBits, hal_bit_t *out0, hal_bit_t *out1, hal_bit_t *out2, hal_bit_t *out3)
{
	uint32_t editTemp = inputWord << (32 - (bitShiftRight + numberOfRestBits));
	editTemp = editTemp >> (32 - (numberOfRestBits));
    *out0 = (editTemp == 0);
    *out1 = (editTemp == 1);
    *out2 = (editTemp == 2);
    *out3 = (editTemp == 3);
	return;
}
  
static inline double dsgn(double z){ return (z >= 0.0) ? 1.0 : -1.0; }
  
	FUNCTION(read_all) 
	{
		if(!scan){
			if(prBase != 0){
				resolution = (1 << prBase);  
				if(resolution != 0 && screw_pitch != 0){
					incremental_pos_scale = (double)resolution / (double)screw_pitch;
					incremental_pos_scale_rcpt = 1.0 / (double)incremental_pos_scale;
					resolution_old = resolution;
					screw_pitch_old = screw_pitch;
				}
			}
			
			if(reverseDistance < screw_pitch)
			{
				reverseDistanceLocal = screw_pitch/2;	//reverseDistanceLocal
			}
		}
		
		// check for change in scale value
			check_scales(&pos_scale, &pos_scale_old, &pos_scale_rcpt);
			check_scales(&velo_scale, &velo_scale_old, &velo_scale_rcpt);
		// check resolutions
			if(resolution != resolution_old || screw_pitch != screw_pitch_old)
			{
				if(resolution != 0 && screw_pitch != 0.0)
				{
					incremental_pos_scale = resolution / screw_pitch;
					incremental_pos_scale_rcpt = 1.0 / incremental_pos_scale;
					resolution_old = resolution;
					screw_pitch_old = screw_pitch;
				}
				
				if(screw_pitch != 0.0)
				{
					screw_pitch_rcpt = 1 / screw_pitch;
				}
			}
		
		// return value from incremental interface
			pos_fb_from_incremental = ((double)drv_actual_position_incremental) * pos_scale_rcpt * incremental_pos_scale_rcpt;
			pos_fb_from_incremental_dro = ((double)drv_actual_position_incremental_dro) * pos_scale_rcpt * incremental_pos_scale_rcpt;
			
			if(drv_probe_edgeOld != drv_probe_edge)
			{
				probedEdge = ((double)drv_probe_edge) * pos_scale_rcpt * incremental_pos_scale_rcpt;
				probedEdgeOld = probedEdge;
				drv_probe_edgeOld = drv_probe_edge;
			}
			
			if(drv_probe_edgeNegOld != drv_probe_edgeNeg)
			{
				probedEdgeNeg = ((double)drv_probe_edgeNeg) * pos_scale_rcpt * incremental_pos_scale_rcpt;
				probedEdgeNegOld = probedEdgeNeg;
				drv_probe_edgeNegOld = drv_probe_edgeNeg;
			}
			
			pos_fb = pos_fb_from_incremental;
		// read velocity feedback from increments to m/s
			velocity_fb_from_incremental = (((double)drv_actual_velocity_incremental) * screw_pitch * velo_scale_rcpt)/(one_velo_increments * minute_to_second);
		
		if(home || homingStatus != homing_initHomingSwitch)
		{
			pos_fb = pos_cmd;
		}
		else
		{
			pos_fb = pos_fb + homeProbedOffset; // this replace by statement upper
		}
		
		stat_drive_processing_cmds = ((statusword >> 3) & 1);
		stat_rt_bit_1 = ((statusword >> 6) & 1);
		stat_rt_bit_2 = ((statusword >> 7) & 1);
		uint32_t shift = 8;
		uint32_t width = 3;
		uint32_t wordTemp = statusword;
		getOperationBits3(wordTemp, shift, width, &stat_mode_0, &stat_mode_1, &stat_mode_2, &stat_mode_3);
		stat_info = ((statusword >> 11) & 1);
		stat_warning = ((statusword >> 12) & 1);
		stat_error = ((statusword >> 13) & 1) || (hommingError != 0);
		shift = 14;
		width = 2;
		getOperationBits3(wordTemp, shift, width, &stat_not_ready, &stat_ready_main_power_on, &stat_ready_free_to_rotate, &stat_drive_enabled);
		
		stat_di_1 = ((drv_actual_digital_inputs >> 0) & 1);
		stat_di_2 = ((drv_actual_digital_inputs >> 1) & 1);
		stat_di_3 = ((drv_actual_digital_inputs >> 2) & 1);
		stat_di_4 = ((drv_actual_digital_inputs >> 3) & 1);
		stat_di_5 = ((drv_actual_digital_inputs >> 4) & 1);
		stat_di_6 = ((drv_actual_digital_inputs >> 5) & 1);
		stat_di_7 = ((drv_actual_digital_inputs >> 6) & 1);
			
		// update fault output
		if (auto_fault_reset_delay > 0) {
			auto_fault_reset_delay -= period;
		} 
		else {
			drv_fault = (stat_fault || stat_cold_restart_error) && enable;
		}
	}
	
	FUNCTION(write_all)
	{
		double positionOutput = pos_cmd;
		if(!estop)
		{
			if(drive_enable)
			{
				//controlword |= (1 << 10);
				controlword |= (1 << 13);
				controlword |= (1 << 14);
				controlword |= (1 << 15);
			}
			else
			{
				//controlword &= ~(1 << 10);
				controlword &= ~(1 << 13);
				controlword &= ~(1 << 14);
				controlword |= (1 << 15);
			}
		}
		else
		{
			controlword = 0;
		}
		
		controlword ^= (1 << 10);
		
		//probe_on = 0;
		probe_on = home_state == homing_searching_ForProbeWithAccell 
								|| home_state == homing_searching_ForProbeConstSpeed
								|| home_state == homing_searching_deccellerationAfterProbeHit
								|| home_state == homing_searching_zeroPointPtpMovementCalculusEdgeFind
								|| home_state == homing_searching_zeroPointPtpMovementEdgeFind
								|| home_state == homing_searching_zeroPointPtpMovementCalculus
								|| home_state == homing_searching_zeroPointPtpMovement;
		
		//controlword = (controlword & ~(1 << 7)) | ((probe_on ? 1 : 0) << 7);
		if (probe_on == 1)
			controlword |= (1 << 7);
		else
			controlword &= ~(1 << 7);
		
		if(home)
		{
			double deccellerationAfterProbeHit;
			//bool probe;
			//probe = homeSwitchNoConfig ? homeSwitch : !homeSwitch;
			bool homeSwitchLocal;
			homeSwitchLocal = homeSwitchNoConfig ? homeSwitch : !homeSwitch;
			
			/*
			if (!homeSwitchNoConfig) 
			{
				homeSwitchLocal = !homeSwitch;
			}
			else
			{
				homeSwitchLocal = homeSwitch;
			}
			*/
			switch (home_state){
				case homing_initHomingSwitch:
				{
					probe_on = 0;
					ui_delay = 0;
					latching = false;
					stepper = false;
					stat_homed = false;
					stat_homing = true;
					ui_delay = 0;
					homingSpeedSI = homingSpeed;
					hommingAccelSI = homingAccel;
					hommingAccelSI = fabs(hommingAccelSI);
					
					homingSpeedLocal = 0;
					homingSpeedLocalOld = 0;
					homeProbedOffset = 0.0;
					homeFailedOffsett = 0.0;
					
					probeEdgeOld = probedEdge;
					
					positionOutput = pos_fb_from_incremental;
					positionMemory = positionOutput;
					phase = ptpMov_accellMovement;
					
					if (homingMethod != 0 && abs(homingMethod) <= 2)
					{
						if(homeSwitchLocal)
						{
							home_state = homing_accellOutFromHomingSwitch;
							//home_state = homing_searching_ForProbeWithAccell;
						}
						else
						{
							home_state = homing_searching_ForProbeWithAccell;
						}
					}
					else
					{
						hommingError = home_state + 1000;
						home_state = homing_initHomingSwitch;
					}
				}
				break;

				case homing_accellOutFromHomingSwitch:
				{
					// Get direction from speed sign
					double direction = (homingSpeedSI >= 0.0) ? -1.0 : 1.0;
					double speed_target = homingSpeedSI * direction;  // Ensure correct sign
					double speed_current = homingSpeedLocalOld;
					double accel_mag = fabs(hommingAccelSI);
					positionOutput = positionMemory;
					positionMemory = positionOutput;
					
					if(homeSwitchLocal || (!homeSwitchLocal && ui_delay < minimalHomeSwitchPresentDelay))
					{
						// Apply acceleration in opposite direction to move away from switch
						if(direction > 0.0)
						{
							// Moving positive, accelerate negative to move away
							if(fabs(speed_current) < fabs(speed_target))
							{
								speed_current = speed_current + direction * accel_mag * periodTime;
							}
							
							// Calculate position: s = s0 + v0*t - 0.5*a*t^2
							double displacement = speed_current * periodTime + direction * 0.5 * accel_mag * periodTime * periodTime;
							positionOutput = positionMemory + displacement;
							homingSpeedLocalOld = speed_current;
							positionMemory = positionOutput;
							
							// Check if we've reached target speed (in opposite direction)
							if(fabs(speed_current) >= fabs(speed_target))
							{
								//speed_current = -fabs(speed_target);
								//homingSpeedLocalOld = speed_current;
								ui_delay = 0;
								home_state = homing_cruiseMovingFromHomingSwitch;
							}
						}
						else
						{
							// Moving negative, accelerate positive to move away
							if(fabs(speed_current) < fabs(speed_target))
							{
								speed_current = speed_current + direction * accel_mag * periodTime;
							}
							
							// Calculate position: s = s0 + v0*t + 0.5*a*t^2
							double displacement = speed_current * periodTime + direction * 0.5 * accel_mag * periodTime * periodTime;
							positionOutput = positionMemory + displacement;
							homingSpeedLocalOld = speed_current;
							positionMemory = positionOutput;
							
							// Check if we've reached target speed (in opposite direction)
							if(fabs(speed_current) >= fabs(speed_target))
							{
								ui_delay = 0;
								home_state = homing_cruiseMovingFromHomingSwitch;
							}
						}
					}
					else
					{
						ui_delay = 0;
						double displacement = speed_current * periodTime;
						positionOutput = positionMemory + displacement;
						homingSpeedLocalOld = speed_current;
						positionMemory = positionOutput;
						home_state = homing_cruiseMovingFromHomingSwitch;
					}
					
					if (!homeSwitchLocal)
					{
						ui_delay++;
					}
					
					homingSpeedLocalOld = speed_current;
					positionMemory = positionOutput;
				}
				break;

				case homing_cruiseMovingFromHomingSwitch:
				{
					positionOutput = positionMemory;
					positionMemory = positionOutput;
					
					// Get direction (should be opposite of homing direction to move away from switch)
					double direction = (homingSpeedSI >= 0.0) ? -1.0 : 1.0;  // Opposite direction
					double speed = fabs(homingSpeedSI);
					
					positionOutput = positionMemory + (homingSpeedLocalOld * periodTime);
					positionMemory = positionOutput;
					
					if(!homeSwitchLocal)
					{
						if(ui_delay > minimalHomeSwitchPresentDelay)
						{
							ui_delay = 0;
							home_state = homing_deccellAfterMovingFromHomingSwitch;
						}
						else
						{
							ui_delay++;
						}
					}
				}
				break;

				case homing_deccellAfterMovingFromHomingSwitch:
				{
					if (hommingDeccel == 0.0)
					{
						deccellerationAfterProbeHit = fabs(hommingAccelSI) * 10;
					}
					else
					{
						deccellerationAfterProbeHit = fabs(hommingDeccel);
					}
					
					double speed_current = homingSpeedLocalOld;
					double decel_mag = deccellerationAfterProbeHit;
					double decel_dir = (speed_current >= 0.0) ? -1.0 : 1.0;  // Decelerate toward zero
					
					// Apply deceleration
					speed_current = speed_current + decel_dir * decel_mag * periodTime;
					
					// Clamp speed to zero if we overshoot
					if((decel_dir < 0 && speed_current < 0) || (decel_dir > 0 && speed_current > 0))
					{
						speed_current = 0.0;
					}
					
					// Calculate displacement using average velocity
					double avg_speed = (homingSpeedLocalOld + speed_current) * 0.5;
					double displacement = avg_speed * periodTime;
					
					positionOutput = positionMemory + displacement;
					positionMemory = positionOutput;
					homingSpeedLocalOld = speed_current;
					
					if (fabs(speed_current) < nearZero)  // Nearly stopped
					{
						homingSpeedLocalOld = 0.0;
						if(ui_delay > waitingDelay)
						{
							ui_delay = 0;
							home_state = homing_searching_ForProbeWithAccell;
						}
						else
						{
							ui_delay++;
						}
					}
				}
				break;

				case homing_searching_ForProbeWithAccell:
				{
					double target_speed = homingSpeedSI;
					double current_speed = homingSpeedLocalOld;
					double accel_mag = fabs(hommingAccelSI);
					
					// Calculate speed difference
					double speed_diff = target_speed - current_speed;
					
					// Determine acceleration direction
					double accel_dir = (speed_diff >= 0.0) ? 1.0 : -1.0;
					
					// Apply acceleration
					double speed_change = accel_dir * accel_mag * periodTime;
					
					// Don't overshoot the target speed
					if (fabs(speed_change) > fabs(speed_diff))
					{
						homingSpeedLocalOld = target_speed;
					}
					else
					{
						homingSpeedLocalOld = current_speed + speed_change;
					}
					
					// Calculate displacement using average velocity
					double avg_velocity = (current_speed + homingSpeedLocalOld) * 0.5;
					double displacement = avg_velocity * periodTime;
					
					positionOutput = positionMemory + displacement;
					positionMemory = positionOutput;
					
					// Check if we've reached target speed (with tolerance)
					if (fabs(homingSpeedLocalOld - target_speed) < nearZero)
					{
						home_state = homing_searching_ForProbeConstSpeed;
					}
					
					// Check for probe trigger
					if(probedEdge != probeEdgeOld)
					{
						probeEdgeOld = probedEdge;
						probedEdgeFromSwitch = pos_fb_from_incremental;
						home_state = homing_searching_deccellerationAfterProbeHit;
					}
				}
				break;

				case homing_searching_ForProbeConstSpeed:
				{
					positionOutput = positionMemory + (homingSpeedSI * periodTime);
					positionMemory = positionOutput;
					
					if(probedEdge != probeEdgeOld)
					{
						probeEdgeOld = probedEdge;
						probedEdgeFromSwitch = pos_fb_from_incremental;
						homingSpeedLocalOld = homingSpeedSI;
						home_state = homing_searching_deccellerationAfterProbeHit;
					}
				}
				break;

				case homing_searching_deccellerationAfterProbeHit:
				{
					if (hommingDeccel == 0.0)
					{
						deccellerationAfterProbeHit = fabs(hommingAccelSI) * 10;
					}
					else
					{
						deccellerationAfterProbeHit = fabs(hommingDeccel);
					}
					
					double speed_current = homingSpeedLocalOld;
					double decel_mag = deccellerationAfterProbeHit;
					double decel_dir = (speed_current >= 0.0) ? -1.0 : 1.0;  // Decelerate toward zero
					
					// Apply deceleration
					speed_current = speed_current + decel_dir * decel_mag * periodTime;
					
					// Clamp speed to zero if we overshoot
					if((decel_dir < 0 && speed_current < 0) || (decel_dir > 0 && speed_current > 0))
					{
						speed_current = 0.0;
					}
					
					// Calculate displacement using average velocity
					double avg_speed = (homingSpeedLocalOld + speed_current) / 2.0;
					double displacement = avg_speed * periodTime;
					
					positionOutput = positionMemory + displacement;
					positionMemory = positionOutput;
					homingSpeedLocalOld = speed_current;
					
					if (fabs(speed_current) < nearZero)  // Nearly stopped
					{
						homingSpeedLocalOld = 0.0;
						positionMemory = positionOutput;
						//ui_delay = 0;
						//stepper = false;
						stepper = true;
						if(stepper)
						{
							if(ui_delay > waitingDelay)
