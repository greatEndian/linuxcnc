								v = vlim_abs * dir;
								if (Tc > 0)
								{
									phase = ptpMov_cruiseMovement;
								}
								else
								{
									phase = ptpMov_deccellMovement;
								}
							}
						}
						break;
							
						case ptpMov_cruiseMovement:
						{
							// Cruise phase
							a = 0.0;
							v = vlim_abs * dir;
							positionOutput = positionMemory + v * periodTime;
							
							t_cruise_elapsed += periodTime;
							if (t_cruise_elapsed >= Tc)
							{
								phase = ptpMov_deccellMovement;
							}
						}
						break;
							
						case ptpMov_deccellMovement:
						{
							// Deceleration phase
							a = -alim_abs * dir;
							v += a * periodTime;
							
							positionOutput = positionMemory + v * periodTime - 0.5 * a * periodTime * periodTime;
							
							t_dec_elapsed += periodTime;
							if (t_dec_elapsed >= Td)
							{
								// End of movement
								v = 0.0;
								a = 0.0;
								phase = ptpMov_finalDelay;
							}
						}
						break;
						
						case ptpMov_finalDelay:
						{
							positionOutput = positionMemory;
							double finalMovement = xf - pos_fb_from_incremental;
							if(fabs(finalMovement) > nearZero)
							{
