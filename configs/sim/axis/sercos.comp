					}
					positionMemory = positionOutput;
				}
				break;

				case homing_offsetting_zeroPointPtpMovementCalculus:
				{
					stepper = false;
					if(homingSpeedSI != 0.0)
					{
						vlim = homingSpeedSI;
					}
					else
					{
						vlim = fabs(homingSpeed); // Use default homing speed if not set
					}
					
					if(hommingAccelSI != 0.0)
					{
						alim = hommingAccelSI;
					}
					else
					{
						alim = fabs(homingAccel); // Use default homing acceleration if not set
					}
					
					// Use absolute values for calculations
					vlim_abs = fabs(vlim);
					alim_abs = fabs(alim);
					
					// Start from current position
					x0 = pos_fb_from_incremental;
					
					// Target is the current zero point (which is probedEdge or probedEdgeNeg) plus the final offset
					double zeroPoint = 0.0;
					if(homingMethod >= 0)
					{
						zeroPoint = probedEdge; // Rising edge zero point
					}
					else
					{
						zeroPoint = probedEdgeNeg; // Falling edge zero point
					}
					
					// Apply final offset: homeFinalOffset should be the desired machine coordinate position
					// For example, if you want the zero point to be at machine coordinate 10mm, set homeFinalOffset = 10.0
					// If you want the zero point at -5mm, set homeFinalOffset = -5.0
					xf = zeroPoint - homeFinalOffset;
					
					// trajectory calculation
					double posDif = xf - x0;
					
					// Calculate direction based on actual needed movement
					if(fabs(posDif) < pos_eps)
					{
						// Already at target
						dir = 0.0;
					}
					else
					{
						dir = (posDif >= 0.0) ? 1.0 : -1.0;
						//dir = (homeFinalOffset >= 0.0) ? 1.0 : -1.0;
