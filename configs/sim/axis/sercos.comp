						break;
					}
					positionMemory = positionOutput;
				}
				break;

				case homing_searching_zeroPointPtpMovementCalculus:
				{
					hommingAccelSI = fabs(hommingAccelSI);
					
					vlim = fabs(homingSpeedSI);
					alim = fabs(hommingAccelSI);
					
					// actual position point setup
					x0 = pos_fb_from_incremental;
					// target position point setup
					if(homingMethod >= 0)
					{
