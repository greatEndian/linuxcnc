												stepper = false;
												home_state = homing_searching_zeroPointPtpMovementCalculus;
												ui_delay = 0;
											}
											else
											{// falling edge homing method
												if (probedEdgeNeg != 0.0)
												{
													phase = ptpMov_accellMovement;
													stepper = false;
													home_state = homing_searching_zeroPointPtpMovementCalculus;
													ui_delay = 0;
												}
												else
												{
													hommingError = home_state + 1001;
													return;
												}
											}
										break;
										
										case 2: // latching trigger
											if (latching)
											{
												if(homingMethod > 0)
												{// rising edge homing method
													phase = ptpMov_accellMovement;
													stepper = false;
													home_state = homing_searching_zeroPointPtpMovementCalculus;
													ui_delay = 0;
												}
												else
