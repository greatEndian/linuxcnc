								v=0;
								a=0;
								phase = ptpMov_finalDelay;
							}
						break;
							
						case ptpMov_finalDelay:
							double finalMovement = xf - pos_fb_from_incremental;
							if(fabs(finalMovement) > nearZero)
							{
								positionOutput = positionMemory + (finalMovement * 0.001);
							}
							else
							{
								positionOutput = positionMemory;
								if(ui_delay > waitingDelay)
								{
									phase = ptpMov_accellMovement;
									stepper = false;
									home_state = homing_zeroPointOffsetSetup;
									ui_delay = 0;
								}
								else
								{
									ui_delay++;
								}
