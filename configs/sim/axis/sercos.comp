	pin out bit stat_info								"status word bit 11";
	pin out bit stat_warning							"status word bit 12";
	pin out bit stat_error								"status word bit 13";
	pin out bit stat_mode_0								"";
	pin out bit stat_mode_1								"";
	pin out bit stat_mode_2								"";
