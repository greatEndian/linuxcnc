//parameters
	param rw float pos_scale		"increments per machine unit";
	param rw float velo_scale		"velocity in machine units per 1 Motor revolution";
	param rw bit auto_fault_reset	"true resets an actual Drive Fault automatically at the next enable Signal";
	param rw float lead_cycles		"How many cycles ahead to predict (>=1)";
	param rw float kff				"Feed-forward gain for the predictive lead term (0..1+), default 1.0";
	param rw float k_err			"Small corrective gain from following error (pos_cmd - pos_fb). Keep small (e.g., 0..0.2)";
	param rw float tau				"Optional first-order output filter time constant [s]. 0 disables filtering";

//internals
