				case homing_resetProbe:
				{
					int32_t homingMethodLocal = abs(homingMethod);
					
					positionOutput = positionMemory;
					positionMemory = positionOutput;
					
					switch (homingMethodLocal){
						case 1: //no latching
							if(homingMethod > 0)
							{// rising edge homing method
								phase = ptpMov_accellMovement;
								stepper = false;
								home_state = homing_zeroPointOffsetSetup;
								ui_delay = 0;
							}
							else
							{
								if (probedEdgeNeg != 0.0)
								{
									phase = ptpMov_accellMovement;
									stepper = false;
									home_state = homing_zeroPointOffsetSetup;
									ui_delay = 0;
								}
								else
								{
									hommingError = home_state + 1001;
									return;
								}
							}
						break;
						
						case 2: //final latching
							
							if(ui_delay > waitingDelay)
							{
								if(homingSpeedLatch != 0.0)// speed edit to latch
								{
									homingSpeedSI = homingSpeedLatch;
								}
								else
								{
									homingSpeedSI = homingSpeed * 0.2;
								}
							
								if(homingAccelLatch != 0.0)// accell edit to latch
								{
									hommingAccelSI = homingAccelLatch;
								}
								else
								{
									hommingAccelSI = homingAccel * 0.2;
								}
								
								hommingAccelSI = fabs(hommingAccelSI);
								
								latching = true;
								home_state = homing_searching_ForProbeWithAccell;
								ui_delay = 0;
							}
							else
							{
								if (latching)
								{
									phase = ptpMov_accellMovement;
									stepper = false;
									latching = false;
									home_state = homing_zeroPointOffsetSetup;
									ui_delay = 0;
								}
								else
								{
									ui_delay++;
								}
							}
						break;
					}
					positionOutput = positionMemory;
					positionMemory = positionOutput;
				}
				break;

				case homing_zeroPointOffsetSetup:
				{
					if(homingMethod >= 0)
					{// homing at rising edge offset setup
						if(probedEdge >= 0.0)
						{
							homeProbedOffset = -fabs(probedEdge);
						}
						else
						{
							homeProbedOffset = fabs(probedEdge);
						}
					}
					else
					{// homing at falling edge offset setup
						if(probedEdgeNeg >= 0.0)
						{
							homeProbedOffset = -fabs(probedEdgeNeg);
						}
						else
						{
							homeProbedOffset = fabs(probedEdgeNeg);
						}
					}
					
					if (homeProbedOffset != homeProbedOffsetOld)
					{
						if (homeFinalOffset != 0.0) 
						{
							home_state = homing_offsetting_zeroPointPtpMovementCalculus;
						}
						else
						{
							home_state = homing_deinitHomingSwitch;
						}
					}
					
					positionOutput = positionMemory;
					positionMemory = positionOutput;
				}
				break;

				case homing_deinitHomingSwitch:
				{
					if(homeProbedOffset != 0)
					{
						//probeEdgeOld = probedEdge;
						homeFailedOffsett = 0.0;
						homeProbedOffsetOld = homeProbedOffset;
						stat_homed = true;
						home_state = homing_initHomingSwitch;
						positionOutput = positionMemory;
						positionMemory = positionOutput;
						ui_delayFinal = waitingDelay;
						home = false;
					}
				}
				break;
			}
			homingStatus = home_state;
			
		}
		else
		{
			stat_homing = false;
			home_state = homing_initHomingSwitch;
			
			if(hommingError || homingStatus != homing_initHomingSwitch)
			{
				positionOutput = positionMemory;
				if (!drive_enable)
				{
					homeProbedOffset = pos_cmd - positionMemory;
					homingStatus = homing_initHomingSwitch;
				}
			}
			else
			{
				positionOutput = pos_cmd - homeProbedOffset;
			}
		}
		
		positionOutputCompensated = positionOutput;
		
		// 1. Calculate the time shift continuously using floating point precision
		const double LTs = lead_cycles * periodTime; 

		// 2. Pure velocity lookahead (perfectly counters linear speed-dependent lag)
		double lead = vel_cmd * LTs;

		// 3. Apply the feedforward gain (kff should be tuned to 1.0)
		posCompensation = kff * lead;

		// 4. Always apply the compensation, even at a standstill.
		// This prevents the violent "snap back" when vel_cmd reaches 0.0.
		positionOutputCompensated = positionOutput + posCompensation;

		// 5. Calculate and track the following error strictly for diagnostics.
		// Notice that ferr is NO LONGER fed back into posCompensation.
		double ferr = positionOutput - pos_fb_from_incremental;

		if(fabs(ferr) > fabs(fErrorOld) || fTopError == 0.0)
		{
			fErrorOld = ferr;
			fTopError = fErrorOld;
		}
		
		//positionOutputCompensated = positionOutput + posCompensation;
		
		if(ui_delayFinal > 0)
		{
			positionOutputCompensated = positionOutput;
			ui_delayFinal--;
		}
		
		//drv_target_position_incremental = (int32_t)(positionOutput * pos_scale * incremental_pos_scale);
		drv_target_position_incremental = (int32_t)(positionOutputCompensated * pos_scale * incremental_pos_scale);
		
		if(screw_pitch){
			drv_target_velocity_incremental = (int32_t)(((double)(vel_cmd) * minute_to_second * one_velo_increments * velo_scale)/ screw_pitch);
		}
		
		homeSwitchOld = homeSwitch;
	}
